# Bitcoin Transaction Fraud Detection — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Dataset ────────────────────────────────────────────────────
# Path to the extracted Elliptic dataset folder.
# Should contain: elliptic_txs_features.csv,
#                 elliptic_txs_classes.csv,
#                 elliptic_txs_edgelist.csv
# Leave blank to auto-download via KaggleHub.
BITCOIN_DATA_PATH=

# ── Kaggle credentials (needed for auto-download) ──────────────
# Get these from https://www.kaggle.com/settings → API → Create New Token
# Not needed if BITCOIN_DATA_PATH is set and data already exists locally.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Outputs ────────────────────────────────────────────────────
# Where to save model weights, metrics, and plots.
# Defaults to ./outputs if not set.
OUTPUT_DIR=./outputs

# ── Training (optional overrides) ─────────────────────────────
# Uncomment to override defaults set in configs/config.py
# SEEDS=42,123,2024,17,99
# EPOCHS=200
# HIDDEN_DIM=256
# LEARNING_RATE=0.001
